{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for the BicLex Hub desktop windows",
  "windows": ["main", "screen-*", "image-preview-*", "server-settings"],
  "permissions": [
    "core:default",
    "core:window:allow-create",
    "core:webview:allow-create-webview-window",
    "dialog:default",
    "process:default",
    "updater:default"
  ]
}
